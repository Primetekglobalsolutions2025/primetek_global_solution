{
  "manifest_version": 3,
  "name": "Primetek Activity Tracker",
  "version": "1.0.0",
  "description": "Silent background activity tracker and attendance sync for Primetek Global Solutions",
  "permissions": [
    "storage",
    "idle",
    "activeTab",
    "alarms",
    "tabs",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
